<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:text="@string/delivery_partner_label"
                    android:textColor="@color/text_secondary"></TextView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:id="@+id/textDriverGreeting"
                    android:textStyle="bold"></TextView>
            </LinearLayout>
            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:textSize="18sp"
                android:id="@+id/textDashboardAvatar"
                android:gravity="center"
                android:textColor="@color/white"></TextView>
        </LinearLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/switchOnline"
            android:text="@string/online"
            android:paddingHorizontal="12dp"
            android:minHeight="48dp"
            android:background="@color/success_surface"
            android:layout_marginTop="14dp"></com.google.android.material.materialswitch.MaterialSwitch>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:id="@+id/textLocationReady"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="@color/success_surface"
            android:textColor="@color/accent_green"
            android:layout_marginTop="8dp"></TextView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:id="@+id/textAssignedCount"
            android:textStyle="bold"
            android:layout_marginTop="16dp"></TextView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonAvailableOrders"
            android:text="@string/available_orders"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonMyDeliveries"
            android:text="@string/my_deliveries"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/recyclerDriverOrders" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textEmptyDriverOrders"
            android:textSize="14sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/surface_light">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonHome"
            android:text="@string/deliveries"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@drawable/ic_motorcycle"
            app:iconGravity="textTop"
            app:iconSize="22dp"
            app:iconPadding="4dp"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:minHeight="64dp"
            android:textColor="@color/primary_orange"
            app:iconTint="@color/primary_orange" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonMyOrders"
            android:text="@string/history"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@drawable/ic_status_placed"
            app:iconGravity="textTop"
            app:iconSize="22dp"
            app:iconPadding="4dp"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:minHeight="64dp"
            android:textColor="@color/text_secondary"
            app:iconTint="@color/text_secondary" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonLogout"
            android:text="@string/account"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@android:drawable/ic_menu_myplaces"
            app:iconGravity="textTop"
            app:iconSize="22dp"
            app:iconPadding="4dp"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:minHeight="64dp"
            android:textColor="@color/text_secondary"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>