<?xml version="1.0" ?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:text="@string/deliver_to"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textDeliveryAddress"
            android:textSize="14sp"
            android:textColor="@color/primary_orange"
            android:minHeight="32dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:text="@string/customer_home"
            android:textStyle="bold"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_dishes"
            android:layout_marginTop="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/editTextSearch"
                android:inputType="text"
                android:textSize="14sp"
                android:minHeight="56dp"
                android:singleLine="true"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/primary_orange_light">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <Spinner
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/spinnerRestaurant"
                android:entries="@array/restaurant_names"
                android:prompt="@string/select_restaurant"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="@string/fresh_meals"
                android:paddingHorizontal="12dp"
                android:paddingBottom="12dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/chipGroupCategory"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:paddingHorizontal="16dp">
        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chipAll"
            android:text="@string/all"
            android:checkable="true"
            android:checked="true"/>
        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chipMeals"
            android:text="@string/meals"
            android:checkable="true"
            android:checked="false"/>
        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/chipDrinks"
            android:text="@string/drinks"
            android:checkable="true"
            android:checked="false"/>
    </com.google.android.material.chip.ChipGroup>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="@string/popular_dishes"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/textNoMatches"
        android:textSize="14sp"
        android:text="@string/no_matches"
        android:visibility="gone"
        android:padding="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/recyclerMenu"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"/>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/primary_orange">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/textCartTotal"
                android:textSize="14sp"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/buttonPlaceOrder"
                android:text="@string/view_cart"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/white"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/surface_light">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonHome"
            android:text="@string/home"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@drawable/ic_destination"
            app:iconGravity="textTop"
            app:iconSize="22dp"
            app:iconPadding="4dp"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:minHeight="64dp"
            android:textColor="@color/primary_orange"
            app:iconTint="@color/primary_orange"/>
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonMyOrders"
            android:text="@string/orders"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@drawable/ic_status_placed"
            app:iconGravity="textTop"
            app:iconSize="22dp"
            app:iconPadding="4dp"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:minHeight="64dp"
            android:textColor="@color/text_secondary"
            app:iconTint="@color/text_secondary"/>
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/buttonLogout"
            android:text="@string/account"
            android:layout_weight="1"
            style="@style/Widget.Material3.Button.TextButton"
            app:icon="@android:drawable/ic_menu_myplaces"
            app:iconGravity="textTop"
            app:iconSize="22dp"
            app:iconPadding="4dp"
            android:textSize="12sp"
            android:paddingHorizontal="4dp"
            android:minHeight="64dp"
            android:textColor="@color/text_secondary"
            app:iconTint="@color/text_secondary"/>
    </LinearLayout>
</LinearLayout>
