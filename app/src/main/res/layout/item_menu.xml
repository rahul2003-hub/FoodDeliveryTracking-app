<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMenuName"
                android:textSize="16sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMenuPrice"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textMenuDescription"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:id="@+id/buttonDecrease"
                    android:text="@string/quantity_minus"
                    android:contentDescription="@string/decrease_quantity"
                    android:padding="0dp"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/textQuantity"
                    android:textSize="14sp"
                    android:gravity="center"/>
                <com.google.android.material.button.MaterialButton
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:id="@+id/buttonIncrease"
                    android:text="@string/quantity_plus"
                    android:contentDescription="@string/increase_quantity"
                    android:padding="0dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRemove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:contentDescription="@string/remove_item"
            style="@style/Widget.Material3.Button.IconButton"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="@color/text_secondary"/>
        <ImageView
            android:layout_width="64dp"
            android:layout_height="72dp"
            android:id="@+id/imageMenuItem"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:background="@color/muted_surface"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
